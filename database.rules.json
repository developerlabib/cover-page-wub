{
  "rules": {
    ".read": false,
    ".write": false,
    "coverDrafts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['schemaVersion', 'template', 'quality', 'fields', 'updatedAt'])",
        "schemaVersion": {
          ".validate": "newData.val() === 1"
        },
        "template": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8 && newData.val() % 1 === 0"
        },
        "quality": {
          ".validate": "newData.val() === 'original' || newData.val() === 'balanced' || newData.val() === 'compact'"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "fields": {
          "$field": {
            ".validate": "($field === 'assignmentNo' || $field === 'degree' || $field === 'topic' || $field === 'courseTitle' || $field === 'courseCode' || $field === 'submissionDate' || $field === 'studentName' || $field === 'regId' || $field === 'program' || $field === 'batch' || $field === 'rollNo' || $field === 'teacherName' || $field === 'designation' || $field === 'department') && newData.isString() && newData.val().length <= 500"
          },
          "showAssignmentNo": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
